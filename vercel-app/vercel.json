{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build.sh",
  "outputDirectory": ".",
  "functions": {
    "api/search.py": {
      "includeFiles": "api/_lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/venues",
      "destination": "/api/search"
    },
    {
      "source": "/api/stats",
      "destination": "/api/search"
    },
    {
      "source": "/api/map.js",
      "destination": "/api/search"
    },
    {
      "source": "/api/suggest",
      "destination": "/api/search"
    },
    {
      "source": "/api/tip",
      "destination": "/api/search"
    },
    {
      "source": "/api/method",
      "destination": "/api/search"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/explorer",
      "destination": "/explorer.html"
    },
    {
      "source": "/method",
      "destination": "/method.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    }
  ]
}
